# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets stay local; the committed template is .env.example
.env*
!.env.example
# rendered production runtime env + deploy state
/deploy/app.env
/deploy/app.env.bak*
/deploy/.deploy/
/deploy/build.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent / editor scratch — machine-specific paths, never shared
# (shared, portable skills live in .agents/skills and are tracked)
.claude/
.codex/
.cursor/
.grok/
.impeccable/

# stray screenshot artifacts from tooling
/--full-page
/desktop-full.png
/vp-*.png
