# Build context exclusions for the production image (SKILL §15.1).
# Keep the context tiny and make sure secrets never enter a layer.

node_modules
.next
out
build
coverage

.git
.gitignore
.github
.vercel

# Secrets: only the committed template belongs in an image.
.env
.env.*
!.env.example
# Deployment config, rendered runtime env and deploy state are host-only.
deploy

# Local tooling / editor scratch
.claude
.codex
.cursor
.grok
.impeccable
.vscode
.idea

# Docs and plans are not needed at runtime.
*.md
docs

# OS / editor noise
.DS_Store
npm-debug.log*
*.tsbuildinfo
next-env.d.ts
