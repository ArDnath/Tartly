# ============================================================================
#  Lunabox — environment template
# ============================================================================
#
#  Copy this file to `.env.local` for local development (Next.js loads it
#  automatically) and fill in real values:
#
#      cp .env.example .env.local
#
#  Only the "1. REQUIRED" block below has to be set to boot the app, sign in,
#  and open the mail client. Everything after it is optional: when a key is
#  left blank the related feature cleanly disables itself instead of crashing.
#  That keeps a fresh clone runnable with just a Postgres database, a Google
#  OAuth app, and an Upstash Redis instance.
#
#  Validation lives in `lib/env.ts` (Zod). A missing required value fails fast
#  at server start with a readable message. Blank strings (`FOO=""`) are
#  treated as "unset".
#
#  ── Production vs. local ───────────────────────────────────────────────────
#  On Vercel, DO NOT commit a `.env`. Add each key in
#  Project → Settings → Environment Variables. Note that `NEXT_PUBLIC_*`
#  values are inlined at build time, so they must be correct before a build.
#  Local-only conveniences below (e.g. AI_BUDGET_DISABLED) must not be left on
#  in production.
# ============================================================================


# ============================================================================
#  1. REQUIRED — the app will not start or authenticate without these
# ============================================================================

# Postgres connection string. Neon, Supabase, RDS, or a local Postgres all work.
# Use the pooled endpoint on serverless providers (e.g. Neon "-pooler" host).
# MANDATORY on serverless: each function instance opens its own pool, so the
# unpooled endpoint multiplies connections per instance and exhausts Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Per-instance pool ceiling. Keep it small on serverless (default 5) because
# concurrency comes from instances, not a big pool; raise it for a long-lived
# worker/container. The provider-side pooler is what bounds total connections.
DB_POOL_MAX="5"

# Optional read-replica connection string (Phase D3). When set, `readDb` /
# `readPool` in lib/db point at the replica; repositories opt into reads
# deliberately (see docs/runbooks/read-replicas.md). Leave blank to read from
# the primary. Point this at a pooled replica endpoint too.
DATABASE_REPLICA_URL=""

# Signs session cookies and JWE tokens. Generate one per environment:
#   openssl rand -base64 32
# Rotating it logs every user out.
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Canonical origin the app is served from. OAuth redirect URIs and the session
# cookie are pinned to this exact origin — extras must redirect here (see
# `next.config.ts`), otherwise sign-in fails with "State not found".
# Local: http://localhost:3000   Production: https://your-domain.com
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth 2.0 client (console.cloud.google.com → Credentials).
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
# The "sync your inbox" step additionally requests Gmail + Calendar scopes at
# consent time (see `lib/onboarding/constants.ts`).
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Upstash Redis (REST API) — the session speed layer. Postgres remains the
# source of truth, so a Redis outage degrades performance but does not log
# users out. Create a database at console.upstash.com.
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.com"
UPSTASH_REDIS_REST_TOKEN="your-token-here"


# ============================================================================
#  2. OPTIONAL — AI assistant (agent chat, drafting, triage)
# ----------------------------------------------------------------------------
#  Models are served over an OpenAI-compatible endpoint. Leave
#  OPENCODE_API_KEY blank to run with a built-in offline demo response.
# ============================================================================

# Free Console service-account key: https://opencode.ai/console
OPENCODE_API_KEY=""
# https://opencode.ai/zen/v1      pay-as-you-go (includes free "-free" models)
# https://opencode.ai/zen/go/v1   OpenCode Go subscription models
AI_BASE_URL="https://opencode.ai/zen/v1"
# Required only for Go-subscription models: a stable id per conversation.
OPENCODE_SESSION_ID=""
# Default model. List live models: curl https://opencode.ai/zen/v1/models
AI_MODEL_ID="space-bunny-free"
# Stronger model for multi-step research/reasoning; falls back to AI_MODEL_ID.
AI_MODEL_REASONING_ID=""
# Adapter id, e.g. "opencode". Reserved for future multi-provider routing.
AI_PROVIDER=""
# Set to "false" for providers that reject response_format JSON schemas; calls
# then fall back to heuristics.
AI_STRUCTURED_OUTPUTS="true"


# ============================================================================
#  3. OPTIONAL — Email operator (Gmail mirror, triage, meetings, follow-ups)
# ----------------------------------------------------------------------------
#  This whole pipeline stays OFF until GOOGLE_PUBSUB_TOPIC is set; the webhook
#  and cron routes refuse to run rather than half-work (see `lib/env.ts`).
#  Set these on production once a Pub/Sub topic and cron secret exist.
# ============================================================================

# Vercel cron auth. Vercel sends `Authorization: Bearer $CRON_SECRET`
# automatically. Required as soon as the cron routes are deployed.
CRON_SECRET=""
# Google Pub/Sub topic the Gmail watch publishes to, e.g.
#   projects/<project-id>/topics/gmail-inbox
GOOGLE_PUBSUB_TOPIC=""
# OIDC audience for the push endpoint. Defaults to
# ${BETTER_AUTH_URL}/api/webhooks/gmail when unset.
GOOGLE_PUBSUB_AUDIENCE=""
# Fallback booking link (e.g. Cal.com) when no meeting slot is agreed.
NEXT_PUBLIC_BOOKING_URL=""
# Cheap model for triage/classification; drafting model. Fall back to AI_MODEL_ID.
AI_MODEL_CLASSIFIER_ID=""
AI_MODEL_DRAFT_ID=""
# Per-user daily model-call budget (Upstash counter). Defaults to 500.
AI_DAILY_BUDGET=""
# LOCAL ONLY — set "true" to bypass the budget in development. Leave unset in prod.
AI_BUDGET_DISABLED="false"


# ============================================================================
#  4. OPTIONAL — Agent loop bounds
# ----------------------------------------------------------------------------
#  A single user turn runs until the model is done, checkpointing into
#  segments. These are safety bounds, not the goal; deliberately generous.
# ============================================================================

# Model steps before the runtime checkpoints into a new continuation segment.
AGENT_MAX_STEPS_PER_SEGMENT="16"
# Maximum continuation segments merged into one assistant turn.
AGENT_MAX_SEGMENTS="6"
# Absolute ceiling for one turn; the run is reported as limit_reached above it.
AGENT_MAX_TOTAL_STEPS=""


# ============================================================================
#  5. OPTIONAL — Mail send throttle
# ============================================================================

# Sends per minute per user. Defaults to 30.
MAIL_SEND_RATE_LIMIT=""


# ============================================================================
#  6. OPTIONAL — Web research tools
# ----------------------------------------------------------------------------
#  Until SEARCH_API_KEY is set, research tools answer "not configured".
# ============================================================================

# Adapter id: "tavily" (default).
SEARCH_PROVIDER="tavily"
# Provider key (server-only). Create one at https://tavily.com.
SEARCH_API_KEY=""
# How long a research result may be served from the Postgres cache. Default 24h.
RESEARCH_CACHE_TTL_MS=""


# ============================================================================
#  7. OPTIONAL — Onboarding & marketing surfaces
# ============================================================================

# Cal.com slug embedded on the "book a call" step (the part after cal.com/).
NEXT_PUBLIC_CAL_BOOKING_LINK=""
# Google Search Console ownership token (the `content` value of the HTML tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""


# ============================================================================
#  8. OPTIONAL — AI upgrade: routing, cost & reliability (Phase 0)
# ----------------------------------------------------------------------------
#  All blank defaults are safe. Model chains let a failing model fall over
#  instead of straight to the deterministic fallback.
# ============================================================================

# Ordered fallback candidates per role: comma-separated `provider:model`.
# The primary provider id is "opencode". Example:
#   AI_MODEL_STANDARD_CHAIN="opencode:space-bunny-free,fallback:gpt-4o-mini"
AI_MODEL_FAST_CHAIN=""
AI_MODEL_STANDARD_CHAIN=""
AI_MODEL_REASONING_CHAIN=""

# A second OpenAI-compatible gateway referenced as `fallback:<model>` in a chain.
AI_PROVIDER_FALLBACK_ID="fallback"
AI_PROVIDER_FALLBACK_BASE_URL=""
AI_PROVIDER_FALLBACK_API_KEY=""

# Platform-wide daily AI-call ceiling (all users). Blank = no cap. When hit,
# background classification drops to heuristics; user-initiated chat/draft still runs.
AI_GLOBAL_DAILY_BUDGET=""

# Provider circuit breaker: open after N consecutive failures for M milliseconds.
AI_CIRCUIT_FAILURE_THRESHOLD="5"
AI_CIRCUIT_OPEN_MS="60000"

# Bounded agent context (A3): compact the conversation past this token estimate,
# and cap a single turn's prompt+completion tokens.
AGENT_CONTEXT_TOKEN_THRESHOLD="60000"
AGENT_MAX_TOKENS_PER_RUN="200000"

# Progressive tool disclosure (§5.3). When "true", the agent starts each turn
# with core search/read tools only and unlocks drafting, calendar, research,
# rules, assets and campaign tools on demand via the `activate_tools` tool.
# This shrinks every model request, but changes which tools the model sees, so
# it is opt-in: blank/false keeps the full tool set active.
AGENT_PROGRESSIVE_TOOLS="false"

# Evals: the scripted suites are deterministic and always run. Set to "true" to
# also exercise the optional live-model scenarios in `scripts/agent/evals.ts`
# (costs tokens and depends on the configured gateway).
AGENT_EVAL_LIVE="false"


# ============================================================================
#  9. OPTIONAL — Voice, memory & knowledge (Phase 1)
# ----------------------------------------------------------------------------
#  These ship ENABLED by default (cached and cheap). Set to "false" to
#  hard-disable a capability; per-user toggles live in /settings/writing-style.
# ============================================================================

ASSISTANT_VOICE_ENABLED="true"
ASSISTANT_MEMORY_ENABLED="true"
ASSISTANT_KNOWLEDGE_ENABLED="true"

# ============================================================================
#  10. OPTIONAL — Inbox intelligence (Phase 2)
# ----------------------------------------------------------------------------
#  Sender intelligence is deterministic-first and cached (at most one cheap
#  model call per *new* sender). It ships ENABLED; set to "false" to
#  hard-disable. Per-user toggles live in /settings/senders.
# ============================================================================

SENDER_INTELLIGENCE_ENABLED="true"
COLD_EMAIL_BLOCKER_ENABLED="true"
SENDER_CATEGORIZATION_ENABLED="true"
# Thread summaries are only ever generated on an explicit user request.
THREAD_SUMMARY_ENABLED="true"

# ============================================================================
#  11. OPTIONAL — Plain-English rules (Phase 3)
# ----------------------------------------------------------------------------
#  Compile English automation into structured rules. Evaluation is
#  deterministic-first (static + learned rules never call a model). Ships
#  ENABLED; manage rules in /settings/rules.
# ============================================================================

RULES_ENABLED="true"

# ============================================================================
#  12. OPTIONAL — Communication superpowers (Phase 4)
# ----------------------------------------------------------------------------
#  Smart compose, AI follow-up drafts, meeting briefs, digest and Reply Zero.
#  All are cached/user-initiated with deterministic fallbacks; they ship
#  ENABLED. Set to "false" to hard-disable one.
# ============================================================================

COMPOSE_ASSIST_ENABLED="true"
FOLLOWUP_AI_ENABLED="true"
MEETING_BRIEFS_ENABLED="true"
DIGEST_ENABLED="true"
REPLY_STATUS_ENABLED="true"

# ============================================================================
#  13. OPTIONAL — Insights & translation (Phase 5)
# ----------------------------------------------------------------------------
#  SEMANTIC_SEARCH_ENABLED is evidence-gated and OFF by default; the eval
#  (scripts/email-operator/evals/phase5-insights.ts) shows keyword/fuzzy search
#  is sufficient, so embeddings are not built.
# ============================================================================

INSIGHTS_ENABLED="true"
TRANSLATE_ENABLED="true"
SEMANTIC_SEARCH_ENABLED=""

# ============================================================================
#  14. OPTIONAL — Asset library (Phase 6)
# ----------------------------------------------------------------------------
#  Images/files reusable in compose and campaigns. Default driver is Vercel
#  Blob; set BLOB_READ_WRITE_TOKEN (Vercel injects it). For S3/R2 set
#  ASSET_STORAGE_DRIVER="s3" and the S3_* variables.
#
#  Uploads are client-direct: the browser asks `/api/v1/assets/upload-ticket`
#  for a scoped target, streams bytes straight to storage, then registers the
#  file. Bytes never pass through the function. Blob objects default to private
#  (only reachable via the authenticated proxy); set ASSET_BLOB_ACCESS="public"
#  only for a public-access Blob store. The S3 bucket should stay private.
# ============================================================================

ASSETS_ENABLED="true"
ASSET_STORAGE_DRIVER="vercel-blob"
BLOB_READ_WRITE_TOKEN=""
ASSET_BLOB_ACCESS="private"
ASSET_MAX_BYTES="10485760"
ASSET_ALLOWED_MIME="image/*,application/pdf"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# ============================================================================
#  15. OPTIONAL — Bulk campaigns (Phase 7)
# ----------------------------------------------------------------------------
#  Bulk sending is the riskiest surface in the plan, so campaigns ship OFF.
#  Enable with CAMPAIGNS_ENABLED="true". Limits are conservative by default.
#  CAMPAIGN_REPLY_AUTOMATION: "off" | "drafts" (default) | "autopilot".
# ============================================================================

CAMPAIGNS_ENABLED=""
CAMPAIGN_MAX_RECIPIENTS="5000"
CAMPAIGN_BATCH_SIZE="20"
CAMPAIGN_MAX_PER_HOUR="50"
CAMPAIGN_MAX_PER_DAY="200"
CAMPAIGN_REPLY_AUTOMATION="drafts"

# ============================================================================
#  16. OPTIONAL — Morning briefing, promises & auto-memory
# ----------------------------------------------------------------------------
#  BRIEFING_ENABLED: the once-a-day catch-up popup and the agent's catch-up
#    plan. The per-user toggle (assistant_settings.briefing_enabled) and hour
#    still apply. It never posts into a conversation.
#  COMMITMENTS_ENABLED: promise extraction (both directions) and overdue
#    chaser/reminder drafts. Nothing here ever sends — drafts go through egress.
#  ASSISTANT_AUTO_MEMORY_ENABLED: kill-switch for learning from every exchange.
#    It is ALSO gated by the per-user memoryAutoExtract setting, which defaults
#    OFF, so nothing is learned until the user opts in.
# ============================================================================

BRIEFING_ENABLED="true"
COMMITMENTS_ENABLED="true"
ASSISTANT_AUTO_MEMORY_ENABLED="true"


# ============================================================================
#  17. OPTIONAL — Operational hardening (Phase A)
# ----------------------------------------------------------------------------
#  Structured logging, API rate limits and request-body caps. Every value has a
#  safe default; leave blank unless tuning. Health probes live at
#  /api/health/live and /api/health/ready.
# ============================================================================

# Minimum structured-log level written to stdout/stderr.
# debug | info | warn | error | fatal. Default: info in production, debug locally.
LOG_LEVEL=""

# Per-user requests/minute applied to authenticated API routes. Default 300.
API_RATE_LIMIT_PER_MIN=""
# Stricter per-user ceilings for expensive routes. Defaults: agent 20, assets 30.
AGENT_RATE_LIMIT_PER_MIN=""
ASSET_RATE_LIMIT_PER_MIN=""

# Runtime request validation against the generated OpenAPI contract (Phase C1).
# off | warn | enforce. Default: enforce (reject with 400 before the handler).
# Set "warn" to log `contract.violation` only, or "off" to disable.
API_CONTRACT_VALIDATION=""

# Nonce-based Content Security Policy emitted by proxy.ts (Phase C6).
# off | report | enforce. Default: enforce (blocking). "report" emits the
# non-blocking Content-Security-Policy-Report-Only header for a burn-in. Static
# marketing pages (/ , /terms, /privacy) are skipped: they cannot carry a
# per-request nonce. Violations post to /api/csp-report (below).
CSP_MODE=""
# Optional report sink appended as `report-uri <value>` (relative path or URL).
# Blank defaults to the in-repo collector at /api/csp-report.
CSP_REPORT_URI=""

# Bearer token for the Prometheus scrape endpoint (Phase D5):
#   GET /api/health/metrics  with  Authorization: Bearer <METRICS_TOKEN>
# Min 16 chars. Leave blank to keep the endpoint hidden (404). Used by a
# self-hosted scrape/sidecar; Vercel functions are ephemeral per-instance.
METRICS_TOKEN=""

# ============================================================================
#  18. OPTIONAL — 24/7 Autopilot (overnight unattended replies)
# ----------------------------------------------------------------------------
#  Autopilot lets a mailbox send *safe* replies on its own inside a user-set
#  window. It is OFF by default twice over: the global switch below allows it,
#  but every mailbox policy (autopilot_policies.enabled) still starts disabled.
#
#  AUTOPILOT_ENABLED: explicit "false" hard-disables EVERY unattended send
#    platform-wide, with no deploy — the emergency kill switch. Unset = allowed.
#  AUTOPILOT_MAX_PER_HOUR / AUTOPILOT_MAX_PER_DAY: platform ceilings that clamp
#    a user's policy on write. Defaults: 10/hour, 50/day.
#  AUTOPILOT_MIN_CONFIDENCE: platform floor for auto-send confidence; a user
#    can never choose a weaker value. HIGH | MEDIUM | LOW. Default: HIGH.
#  WEBHOOK_DRAIN_BATCH_SIZE: how many queue jobs the Gmail webhook drains
#    inline in its `after()` callback. Default 5, clamped to QUEUE_MAX_CONCURRENCY.
#  AUTOPILOT_DECISION_RETENTION_DAYS: how long the content-free decision audit
#    is retained. Default 90.
# ============================================================================

AUTOPILOT_ENABLED=""
AUTOPILOT_MAX_PER_HOUR="10"
AUTOPILOT_MAX_PER_DAY="50"
AUTOPILOT_MIN_CONFIDENCE="HIGH"
WEBHOOK_DRAIN_BATCH_SIZE="5"
AUTOPILOT_DECISION_RETENTION_DAYS="90"
