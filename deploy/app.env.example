# ============================================================================
# Tartly — application runtime environment (production).
#
# Consumed by web-1, web-2 and worker via Compose `env_file`. NOT interpolated,
# so values may contain `$` freely. chmod 600; never commit the rendered file.
#
# Generate from the workstation with:
#   node deploy/scripts/render-env.mjs
# ============================================================================

NODE_ENV=production
LOG_LEVEL=info

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgresql://tartly:CHANGE_ME@postgres:5432/tartly
# Per-process pool. 2 web replicas x 8 + worker 4 = 20 of Postgres' 120.
DB_POOL_MAX=8

BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
BETTER_AUTH_URL=https://tartly.in
NEXT_PUBLIC_BETTER_AUTH_URL=https://tartly.in

# --- Google OAuth -----------------------------------------------------------
# Authorized redirect URI: https://tartly.in/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft OAuth (optional) ---------------------------------------------
# Redirect URI: https://tartly.in/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
NEXT_PUBLIC_MICROSOFT_CONNECT_ENABLED=false

# --- Redis (Upstash-compatible REST in front of local Redis) ----------------
UPSTASH_REDIS_REST_URL=http://redis-http:80
UPSTASH_REDIS_REST_TOKEN=CHANGE_ME

# --- Object storage for email assets ---------------------------------------
# "s3" for Cloudflare R2 / AWS S3 / MinIO. Leave unset to use Vercel Blob.
ASSET_STORAGE_DRIVER=s3
S3_BUCKET=tartly-assets
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 has no ACLs; private is the only correct answer.
ASSET_BLOB_ACCESS=private
BLOB_READ_WRITE_TOKEN=

# --- AI provider ------------------------------------------------------------
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://opencode.ai/zen/v1
AI_MODEL_ID=
AI_MODEL_CLASSIFIER_ID=
AI_MODEL_DRAFT_ID=
AI_MODEL_REASONING_ID=
OPENCODE_API_KEY=
OPENCODE_SESSION_ID=
AI_DAILY_BUDGET=
AI_GLOBAL_DAILY_BUDGET=

# --- Billing (Dodo Payments) ------------------------------------------------
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_LIVE_MODE_ENABLED=false
DODO_PRODUCT_MONTHLY=
DODO_PRODUCT_YEARLY=
# Webhook endpoint: https://tartly.in/api/webhooks/dodo

# --- Search / research ------------------------------------------------------
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
RESEARCH_CACHE_TTL_MS=86400

# --- Email operator ---------------------------------------------------------
CRON_SECRET=
# Google Pub/Sub push endpoint: https://tartly.in/api/webhooks/gmail
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
AUTOPILOT_ENABLED=true

# --- Hardening --------------------------------------------------------------
# Bearer token required by GET /api/health/metrics (unset => 404).
METRICS_TOKEN=
# Burn in report-only first; flip to `enforce` after checking reports.
CSP_MODE=report
API_CONTRACT_VALIDATION=enforce

# --- Public, build-time (also mirrored into deploy/.env) --------------------
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_CAL_BOOKING_LINK=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BOOKING_URL=
