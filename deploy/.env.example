# Infrastructure values interpolated by Docker Compose.
# Copy to `.env` (same directory) and fill in. chmod 600.
# Secrets here must not contain `$` (Compose would try to interpolate them).

# Public origin — baked into the client bundle. No trailing slash.
PUBLIC_URL=https://tartly.in

# Domains served by Caddy (Let's Encrypt). Apex + www redirect.
TARTLY_DOMAIN=tartly.in
ACME_EMAIL=support@tartly.in

# Generated on first bootstrap: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
REDIS_REST_TOKEN=change-me

# Deployed git SHA; deploy.sh/release.sh set this automatically.
TAG=latest

# Image references used by Compose. `deploy.sh` points these at locally built
# image tags; `release.sh` (CI/CD) points them at GHCR. Scripts rewrite these
# lines on every release so bare `docker compose` commands stay on the same
# images.
WEB_IMAGE=tartly-web:latest
WORKER_IMAGE=tartly-worker:latest

# Build-time NEXT_PUBLIC_* values (must be present at `next build`).
# Keep in sync with app.env; release.sh rewrites these lines on every deploy.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_CAL_BOOKING_LINK=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_MICROSOFT_CONNECT_ENABLED=false
